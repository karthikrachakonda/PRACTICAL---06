#include <iostream>
using namespace std;

void printOptimalParenthesis(int s[][10], int i, int j)
{
    if (i == j)
    {
        cout << "A" << i;
        return;
    }

    cout << "(";
    printOptimalParenthesis(s, i, s[i][j]);
    printOptimalParenthesis(s, s[i][j] + 1, j);
    cout << ")";
}

int main()
{
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    int p[11];

    cout << "Enter dimensions of matrices:\n";
    cout << "For example, for A1(10x20), A2(20x30), enter: 10 20 30\n";

    for (int i = 0; i <= n; i++)
    {
        cin >> p[i];
    }

    int m[10][10] = {0};
    int s[10][10] = {0};

    // Chain length
    for (int len = 2; len <= n; len++)
    {
        for (int i = 1; i <= n - len + 1; i++)
        {
            int j = i + len - 1;

            m[i][j] = 999999;

            // Try all possible positions for splitting
            for (int k = i; k < j; k++)
            {
                int cost = m[i][k]
                         + m[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                if (cost < m[i][j])
                {
                    m[i][j] = cost;
                    s[i][j] = k;
                }
            }
        }
    }

    cout << "\nMinimum number of scalar multiplications = "
         << m[1][n] << endl;

    cout << "Optimal Parenthesization = ";
    printOptimalParenthesis(s, 1, n);
    cout << endl;

    return 0;
}
